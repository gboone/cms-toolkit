<?xml version="1.0"?>
<ruleset name="CMS Toolkit">
    <description>WordPress Coding Standards for the CMS Toolkit plugin</description>

    <file>.</file>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/tests/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <rule ref="WordPress-Core"/>
    <rule ref="WordPress-Docs"/>
    <rule ref="WordPress-Extra">
        <!-- Plugin files use the cfpb- prefix convention, not WP filename convention -->
        <exclude name="WordPress.Files.FileName"/>
    </rule>

    <config name="minimum_php_version" value="8.0"/>
    <config name="minimum_wp_version" value="6.0"/>
</ruleset>
